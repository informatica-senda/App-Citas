{
    "compilerOptions": {
        "baseUrl": "./",
        "paths": {
            "@/*": [
                "./*"
            ],
            "components":[
                "./components/ui"
            ],
            "admin": [
                "./app/admin"
            ],
            "user": [
                "./app/user"
            ]
        }
    },
    "include": [
