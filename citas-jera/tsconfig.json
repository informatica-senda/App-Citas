{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "baseUrl": "./",
        "paths": {
            "@/*": [
                "./*"
            ],
            "components":[
                "./components/ui"
            ],
            "admin": [
                "./app/admin"
            ],
            "user": [
                "./app/user"
            ]
        }
    },
    "include": [
        "app",
        "**/*.ts",
        "**/*.tsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts",
        "components.js"
, "lib"    ],
    "exclude": [
        "node_modules"
    ]
}